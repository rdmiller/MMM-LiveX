# How every file in the repo is written: UTF-8, LF, a final newline, no trailing spaces, two
# spaces to indent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
